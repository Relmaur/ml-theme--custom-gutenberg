# Integration test database settings.
#
# Copy to tests/php/.env.testing (git-ignored) and adjust. Real environment
# variables (e.g. in CI) take precedence over this file.
#
# ⚠️ The WordPress test suite DROPS AND RECREATES all tables in this database
# on every run. Use a dedicated, empty database, never a real site's.

WP_TESTS_DB_NAME=wp_tests
WP_TESTS_DB_USER=root
WP_TESTS_DB_PASSWORD=root

# TCP (CI, Docker):
WP_TESTS_DB_HOST=127.0.0.1:3306

# Local by Flywheel only listens on a per-site socket. Find it in
# Local → site → Database, or ~/Library/Application Support/Local/run/<site-id>/mysql/mysqld.sock
# WP_TESTS_DB_HOST="localhost:/Users/you/Library/Application Support/Local/run/<site-id>/mysql/mysqld.sock"
